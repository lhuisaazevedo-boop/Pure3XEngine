#!/data/data/com.termux/files/usr/bin/bash

clear
echo "=================================================="
echo "           P3XE HEALTH REPORT"
echo "=================================================="

echo "Data: $(date)"
echo "Projeto: Pure3XEngine"
echo "Arquitetura: $(uname -m)"
echo ""

echo "[ Sistema ]"
echo "SDK...............: $([ -d "$sdk_dir" ] && echo "OK" || echo "ERRO")"
echo "NDK...............: $([ -d "$ndk_dir" ] && echo "OK" || echo "ERRO")"
echo "Gradle............: $(command -v gradle >/dev/null && echo "OK" || echo "NÃO")"
echo "CMake.............: $(command -v cmake >/dev/null && echo "OK" || echo "NÃO")"
echo "Ninja.............: $(command -v ninja >/dev/null && echo "OK" || echo "NÃO")"
echo ""

echo "[ Bibliotecas ]"
ls ../app/src/main/jniLibs/arm64-v8a 2>/dev/null

echo ""

echo "[ Cache ]"
[ -d "../app/.cxx" ] && echo "Encontrado" || echo "Limpo"

echo ""

echo "[ Próximos passos ]"
echo "1. ./doctor.sh"
echo "2. ./repair.sh"
echo "3. ./clean.sh"
echo "4. ./build_com_log.sh"

echo ""
echo "=================================================="
echo "P3XE Development Kit"
echo "=================================================="
